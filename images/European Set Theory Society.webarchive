·_"http://settheory.eu/CSS/tablet.cssÕOX/* Navigation styles */

.center_container {
    margin-left: 10vw;
    margin-right: 10vw;
    margin-bottom: 1rem;
    padding: 5rem;
    padding-bottom: 1rem;
    padding-top: 1rem;
/*    border-left: 0.05rem solid grey; */ 
}


/*==============================================================================================================*/

/* Footer containers*/



.credits_container {
    display: none;
}

.credits_container_desktop {
    display: block;
    height: 2rem;
    padding: 0.8rem;
    padding-left: 4.8rem;
    color: white; /* var(--text-color-footer); */
    background-color: #d5d0c8;
}

.credits_container_desktop a {
/*    padding-left: 2rem; */
    color: white;
}

.credits_container_desktop a:hover {
/*    padding-left: 2rem; */
    color: var(--text-color-hover);
}


#subscribeScreen
{
    width: 45vw;
    left: 25vw;
}
